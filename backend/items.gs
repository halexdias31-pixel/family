/* @family. — items.gs THE ONE GENERAL ACTION (owner, 16 Nov, "go extreme"): `item`, with mode read, write or event. */
/* Every kind is described once, in data/settings/kinds.json (rule 1.80); this file reads it as ITEM_STORE_KINDS (cards-gen.gs, */
/* generated by tools/cards-gen.js). Who may see a kind and which of its fields is kinds.json `see`; who may write it is kinds.json */
/* `edit` when given, else permissions.json's `kind:save` row (ITEM_PERMISSIONS, booking.gs), else an admin alone. Nothing is stated twice. */
/* Where the rows live is the one store (core.gs `read`): a kind listed in kinds.json `ledger.moved` is in the items tab, the rest in their own. */

/* THE KIND, or null. */
function itemKind_(kind) {
  const K = ITEM_STORE_KINDS.kinds;
  return Object.prototype.hasOwnProperty.call(K, kind) ? K[kind] : null;
}

/* WHO IS ASKING, as the see-words need them: the token's row, and the ids of their family (accepted links, either way). */
function itemViewer_(row) {
  if (!row) return { row: null, id: '', admin: false, child: false, staff: false, family: [] };
  const id = S(row.person_id), fam = [];
  itemRows_('family_link').forEach(it => {
    const r = it.data;
    if (norm(r.state) !== 'accepted') return;
    if (S(r.parent_id) === id) fam.push(S(r.child_id));
    if (S(r.child_id) === id) fam.push(S(r.parent_id));
  });
  return { row, id, admin: whoMay_(row, 'admin'), child: isChild_(row), staff: hasRole(row, 'tutor'), family: fam };
}
/* THE ROLE permissions.json names (anyone, member, child, admin). */
function itemRole_(v) { return !v.row ? 'anyone' : v.admin ? 'admin' : v.child ? 'child' : 'member'; }

/* WHOSE AN ITEM IS: the values of its kind's `owner` columns (a cell may list several, comma-separated). */
function itemOwners_(spec, data) {
  const out = [];
  (spec.sheet.owner || []).forEach(c => S(data[c]).split(',').forEach(x => { if (S(x)) out.push(S(x)); }));
  return out;
}

/* THE SEE-WORDS (kinds.json `see.who`): anyone, signedIn, self, family, staff, admin — any one is enough. */
function itemMaySee_(spec, data, v) {
  if (v.admin) return true;
  const words = S((spec.see || {}).who || 'admin').split(',').map(norm);
  if (words.indexOf('anyone') !== -1) return true;
  if (!v.row) return false;
  if (words.indexOf('signedin') !== -1) return true;
  if (words.indexOf('staff') !== -1 && v.staff) return true;
  const owners = itemOwners_(spec, data);
  if (words.indexOf('self') !== -1 && owners.indexOf(v.id) !== -1) return true;
  if (words.indexOf('family') !== -1 && owners.some(o => v.family.indexOf(o) !== -1)) return true;
  return false;
}

/* THE FIELDS THIS VIEWER IS NOT SENT, from kinds.json alone: `ledger.never` (a PIN, a token) for all but an admin, */
/* `see.hide.admin` for all but an admin, `see.hide.prices` for a child (may_('prices'), 398), and outside `sheet.show` when the kind has one. */
function itemHidden_(spec, v) {
  const hide = (spec.see || {}).hide || {};
  return f => {
    if (v.admin) return false;
    if (ITEM_STORE_KINDS.never.indexOf(f) !== -1 || /(^|_)pin$/.test(f)) return true;
    if ((hide.admin || []).indexOf(f) !== -1) return true;
    if (v.child && (hide.prices || []).indexOf(f) !== -1) return true;
    if (spec.sheet.show && spec.sheet.show.indexOf(f) === -1 && [].concat(spec.sheet.id || []).indexOf(f) === -1) return true;
    return false;
  };
}
function itemShape_(spec, data, v) {
  const hidden = itemHidden_(spec, v), out = {};
  Object.keys(data).forEach(f => { if (f.charAt(0) !== '_' && !hidden(f)) out[f] = data[f]; });
  return out;
}

/* ---------- THE STORE: `read` hands back a moved kind from the items/events tabs, a kept one (library, facts, notes) from its own tab. */
function itemIdOf_(sheet, row) {
  const parts = [].concat(sheet.id || []).map(c => S(row[c]));
  return parts.some(p => p === '') ? '' : parts.join(':');
}
function itemKindOf_(kind, sheet, row) {
  const b = sheet.kindBy;
  return b && norm(row[b.column]).indexOf(b.match) !== -1 ? b.kind : kind;
}
/* A BLOB KIND (the library) keeps its JSON in six chunks, as lib_* always did. */
function itemBlob_(row, pre) {
  let s = '';
  for (let i = 1; i <= 6; i++) s += S(row[pre + i]);
  try { return JSON.parse(s); } catch (err) { return null; }
}
function itemRows_(kind) {
  const spec = itemKind_(kind), sh = spec.sheet;
  const home = sh.via ? itemKind_(sh.via).sheet : sh, homeKind = sh.via || kind;
  /* THE ONE STORE (core.gs `read`): a moved kind's rows come from the items tab, the rest from their own tab, shaped alike. */
  return read(home.tab).rows.map(r => {
    const id = itemIdOf_(home, r);
    if (!id || itemKindOf_(homeKind, home, r) !== kind) return null;
    const data = home.blob ? (itemBlob_(r, 'content_') || {}) : Object.assign({}, r);
    delete data._row; delete data._item;
    return { id, kind, data, _row: r };
  }).filter(Boolean);
}

/* ---------- READ: the items of a kind this viewer may see, each shaped for them. A blob kind is read by `ids` only (at most LIB_PER_CALL, as readItems). */
function itemRead_(body, v) {
  const kind = S(body.kind), spec = itemKind_(kind);
  if (!spec || spec.sheet.to === 'events') return { error: 'There is no kind called ' + kind + '.', why: 'kind' };
  const want = Array.isArray(body.ids) ? body.ids.map(S) : null;
  const home = spec.sheet.via ? itemKind_(spec.sheet.via).sheet : spec.sheet;
  if (home.blob && (!want || want.length > LIB_PER_CALL)) return { error: 'Ask for at most ' + LIB_PER_CALL + ' ' + kind + ' ids.', why: 'ids' };
  const items = itemRows_(kind)
    .filter(it => (!want || want.indexOf(it.id) !== -1) && itemMaySee_(spec, it.data, v))
    .map(it => ({ id: it.id, kind, data: itemShape_(spec, it.data, v) }));
  return { ok: true, kind, items };
}

/* ---------- WRITE: one item upserted. The kind's `edit` words, else its permissions.json `save` row, else an admin; */
/* a non-admin writes only an item that is theirs, never another owner onto it, and never a field they would not be sent. */
function itemMayWrite_(kind, spec, v) {
  if (v.admin) return true;
  if (!v.row) return false;
  if (spec.edit) return S(spec.edit.who || spec.edit).split(',').map(norm).some(w => w === 'signedin' || w === 'self' || (w === 'staff' && v.staff));
  return itemMay_(kind, 'save', itemRole_(v)) !== null;
}
function itemWrite_(body, v) {
  const kind = S(body.kind), spec = itemKind_(kind), given = body.item;
  if (!spec || spec.sheet.to === 'events' || spec.sheet.blob) return { error: 'That kind cannot be written here.', why: 'kind' };
  if (!given || typeof given !== 'object' || Array.isArray(given)) return { error: 'Send the item as an object.', why: 'item' };
  if (!itemMayWrite_(kind, spec, v)) return { error: v.row ? 'Not authorised.' : 'Sign in first.', why: v.row ? 'kind' : 'signed-out' };
  const home = spec.sheet.via ? itemKind_(spec.sheet.via).sheet : spec.sheet;
  const t = read(home.tab);
  const id = itemIdOf_(home, given);
  if (!id) return { error: 'The item needs its ' + [].concat(home.id).join(' and ') + '.', why: 'id' };
  const have = itemRows_(kind).find(it => it.id === id);
  const hidden = itemHidden_(spec, v);
  /* THE FIELDS: the kind's own columns (its tab's headers, or what the item already holds), none hidden from this viewer. */
  const known = t.headers;
  const bad = Object.keys(given).filter(f => known.indexOf(f) === -1 || hidden(f));
  if (bad.length) return { error: 'These fields cannot be written: ' + bad.join(', ') + '.', why: 'fields', fields: bad };
  if (!v.admin) {
    const next = Object.assign({}, have ? have.data : {}, given);
    const owners = itemOwners_(spec, next);
    if (owners.indexOf(v.id) === -1 || (have && itemOwners_(spec, have.data).indexOf(v.id) === -1)) return { error: 'That is not yours to change.', why: 'owner' };
  }
  if (have) setCells(t, have._row, given);
  else addRow(t, given);
  clearCache();
  return { ok: true, kind, id, made: !have };
}

/* ---------- EVENT: one row appended, {at, who, kind, what, item, data}. `who` is the token's person (an admin may name another). */
function itemEvent_(body, v) {
  if (!v.row) return { error: 'Sign in first.', why: 'signed-out' };
  const kind = S(body.kind), spec = itemKind_(kind);
  if (!spec || spec.sheet.to !== 'events') return { error: 'There is no event called ' + kind + '.', why: 'kind' };
  const ev = { at: new Date(), who: v.admin && S(body.who) ? S(body.who) : v.id, kind, what: S(body.what), item: S(body.item),
               data: JSON.stringify(body.data && typeof body.data === 'object' ? body.data : {}) };
  /* AN EVENT KIND IS NOT MOVED YET: it is appended to its own tab, in that tab's columns. */
  {
    const s = spec.sheet, row = Object.assign({}, body.data && typeof body.data === 'object' ? body.data : {});
    row[s.at] = ev.at; row[s.who] = ev.who;
    if (s.what) row[s.what] = ev.what;
    if (s.item) row[s.item] = ev.item;
    addRow(read(s.tab), row);
  }
  return { ok: true, kind, at: ev.at };
}

/* THE HANDLER: `anyone` at the gate (access.gs); the token, not the request, says who asks. */
function itemAnswer_(body) {
  const row = S(body.token) ? authWhoIs_(body.token) : null;
  if (S(body.token) && !row) return { error: 'Please sign in again.', why: 'signed-out' };
  const v = itemViewer_(row), mode = S(body.mode || 'read');
  if (mode === 'read') return itemRead_(body, v);
  if (mode === 'write') return itemWrite_(body, v);
  if (mode === 'event') return itemEvent_(body, v);
  return { error: 'mode is read, write or event.', why: 'mode' };
}
/* THE FOLDED DOORS (stage b, 17 Nov): `door` get/save/delete is what readItems/saveItem/deleteItem were, answered by the */
/* very same handlers (post-learning.gs), so every check, field and side effect of the old door is kept. */
function postItem_(body, action, began) {
  const door = S(body.door);
  if (door === 'get') return postReadItems_(body, 'item', began);
  if (door === 'save' || door === 'delete') {
    /* SIGNED IN, as saveItem's own gate was: the token names the person, never the request. */
    const denied = accessDenied('saveItem', body);
    if (denied) return jsonOut(denied === 'Please sign in again.' ? { error: denied, why: 'signed-out' } : { error: denied });
    return itemsWrite_(door, body, began);
  }
  if (door) return jsonOut({ error: 'door is get, save or delete.', why: 'door' });
  return jsonOut(itemAnswer_(body));
}
