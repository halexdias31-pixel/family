{"formula_id": "MA001", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Number", "name": "Percentage change", "formula": "% change = (new − old) ÷ old × 100", "latex": "\\%\\text{ change}=\\frac{\\text{new}-\\text{old}}{\\text{old}}\\times100", "variables": "new, old", "units": "%", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Negative result means a decrease.", "active": "True"},
{"formula_id": "MA002", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Number", "name": "Compound interest", "formula": "A = P(1 + r)^n", "latex": "A=P(1+r)^n", "variables": "A amount, P principal, r rate as decimal, n periods", "units": "currency", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Use (1 − r) for depreciation.", "active": "True"},
{"formula_id": "MA003", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Number", "name": "Speed, distance, time", "formula": "speed = distance ÷ time", "latex": "\\text{speed}=\\frac{\\text{distance}}{\\text{time}}", "variables": "distance, time", "units": "m/s or km/h", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Same triangle works for density and pressure.", "active": "True"},
{"formula_id": "MA004", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Number", "name": "Density", "formula": "density = mass ÷ volume", "latex": "\\rho=\\frac{m}{V}", "variables": "m mass, V volume", "units": "kg/m^3", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA005", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Number", "name": "Pressure", "formula": "pressure = force ÷ area", "latex": "P=\\frac{F}{A}", "variables": "F force, A area", "units": "Pa (N/m^2)", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA006", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Algebra", "name": "Quadratic formula", "formula": "x = (−b ± √(b² − 4ac)) ÷ 2a", "latex": "x=\\frac{-b\\pm\\sqrt{b^2-4ac}}{2a}", "variables": "a, b, c from ax^2+bx+c=0", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the 2026 GCSE formula sheet for all three boards.", "active": "True"},
{"formula_id": "MA007", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Algebra", "name": "Discriminant", "formula": "b² − 4ac", "latex": "b^2-4ac", "variables": "a, b, c", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Positive: two roots. Zero: one repeated. Negative: none.", "active": "True"},
{"formula_id": "MA008", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Algebra", "name": "Gradient of a line", "formula": "m = (y₂ − y₁) ÷ (x₂ − x₁)", "latex": "m=\\frac{y_2-y_1}{x_2-x_1}", "variables": "two points on the line", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA009", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Algebra", "name": "nth term of an arithmetic sequence", "formula": "aₙ = a + (n − 1)d", "latex": "a_n=a+(n-1)d", "variables": "a first term, d common difference, n position", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA010", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Geometry", "name": "Area of a triangle", "formula": "A = ½ × base × height", "latex": "A=\\tfrac{1}{2}bh", "variables": "b base, h perpendicular height", "units": "length^2", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA011", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Geometry", "name": "Area of a trapezium", "formula": "A = ½(a + b)h", "latex": "A=\\tfrac{1}{2}(a+b)h", "variables": "a, b parallel sides, h height", "units": "length^2", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Removed from the formula sheet — must now be learnt.", "active": "True"},
{"formula_id": "MA012", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Geometry", "name": "Circumference of a circle", "formula": "C = 2πr = πd", "latex": "C=2\\pi r=\\pi d", "variables": "r radius, d diameter", "units": "length", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA013", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Geometry", "name": "Area of a circle", "formula": "A = πr²", "latex": "A=\\pi r^2", "variables": "r radius", "units": "length^2", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA014", "subject": "maths", "level": "GCSE", "tier": "Foundation+Higher", "topic": "Geometry", "name": "Pythagoras' theorem", "formula": "a² + b² = c²", "latex": "a^2+b^2=c^2", "variables": "a, b legs; c hypotenuse", "units": "length", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Right-angled triangles only.", "active": "True"},
{"formula_id": "MA015", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Volume of a prism", "formula": "V = area of cross-section × length", "latex": "V=A_{\\text{cross}}\\times l", "variables": "cross-sectional area, length", "units": "length^3", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA016", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Volume of a cylinder", "formula": "V = πr²h", "latex": "V=\\pi r^2h", "variables": "r radius, h height", "units": "length^3", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA017", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Volume of a sphere", "formula": "V = 4⁄3 πr³", "latex": "V=\\tfrac{4}{3}\\pi r^3", "variables": "r radius", "units": "length^3", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet.", "active": "True"},
{"formula_id": "MA018", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Surface area of a sphere", "formula": "A = 4πr²", "latex": "A=4\\pi r^2", "variables": "r radius", "units": "length^2", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet.", "active": "True"},
{"formula_id": "MA019", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Volume of a cone", "formula": "V = ⅓ πr²h", "latex": "V=\\tfrac{1}{3}\\pi r^2h", "variables": "r radius, h perpendicular height", "units": "length^3", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet.", "active": "True"},
{"formula_id": "MA020", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Geometry", "name": "Curved surface area of a cone", "formula": "A = πrl", "latex": "A=\\pi r l", "variables": "r radius, l slant height", "units": "length^2", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Slant height, not perpendicular height.", "active": "True"},
{"formula_id": "MA021", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Trigonometry", "name": "SOHCAHTOA", "formula": "sin θ = opp/hyp,  cos θ = adj/hyp,  tan θ = opp/adj", "latex": "\\sin\\theta=\\frac{o}{h},\\ \\cos\\theta=\\frac{a}{h},\\ \\tan\\theta=\\frac{o}{a}", "variables": "opposite, adjacent, hypotenuse", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Right-angled triangles only.", "active": "True"},
{"formula_id": "MA022", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Trigonometry", "name": "Sine rule", "formula": "a/sin A = b/sin B = c/sin C", "latex": "\\frac{a}{\\sin A}=\\frac{b}{\\sin B}=\\frac{c}{\\sin C}", "variables": "sides a,b,c and opposite angles A,B,C", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet. Watch the ambiguous case.", "active": "True"},
{"formula_id": "MA023", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Trigonometry", "name": "Cosine rule", "formula": "a² = b² + c² − 2bc cos A", "latex": "a^2=b^2+c^2-2bc\\cos A", "variables": "sides a,b,c and angle A", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet.", "active": "True"},
{"formula_id": "MA024", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Trigonometry", "name": "Area of a triangle (sine)", "formula": "A = ½ab sin C", "latex": "A=\\tfrac{1}{2}ab\\sin C", "variables": "a, b sides; C included angle", "units": "length^2", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "On the formula sheet.", "active": "True"},
{"formula_id": "MA025", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Probability", "name": "Addition rule", "formula": "P(A or B) = P(A) + P(B) − P(A and B)", "latex": "P(A\\cup B)=P(A)+P(B)-P(A\\cap B)", "variables": "P(A), P(B)", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Subtract the overlap unless mutually exclusive.", "active": "True"},
{"formula_id": "MA026", "subject": "maths", "level": "GCSE", "tier": "Higher", "topic": "Probability", "name": "Multiplication rule", "formula": "P(A and B) = P(A) × P(B given A)", "latex": "P(A\\cap B)=P(A)\\,P(B\\mid A)", "variables": "P(A), P(B|A)", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Independent events: P(B|A) = P(B).", "active": "True"},
{"formula_id": "MA027", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — algebra", "name": "Binomial expansion", "formula": "(a + b)ⁿ = Σ nCr a^(n−r) b^r", "latex": "(a+b)^n=\\sum_{r=0}^{n}\\binom{n}{r}a^{n-r}b^r", "variables": "n index, r term number", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "In the formulae booklet.", "active": "True"},
{"formula_id": "MA028", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — sequences", "name": "Sum of an arithmetic series", "formula": "Sₙ = n/2 (2a + (n − 1)d) = n/2 (a + l)", "latex": "S_n=\\tfrac{n}{2}\\big(2a+(n-1)d\\big)=\\tfrac{n}{2}(a+l)", "variables": "a first term, d difference, l last term", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "", "active": "True"},
{"formula_id": "MA029", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — sequences", "name": "Sum of a geometric series", "formula": "Sₙ = a(1 − rⁿ)/(1 − r);  S∞ = a/(1 − r) for |r| < 1", "latex": "S_n=\\frac{a(1-r^n)}{1-r},\\quad S_\\infty=\\frac{a}{1-r}\\ (|r|<1)", "variables": "a first term, r ratio", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Sum to infinity needs |r| < 1.", "active": "True"},
{"formula_id": "MA030", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — trigonometry", "name": "Pythagorean identity", "formula": "sin²θ + cos²θ = 1", "latex": "\\sin^2\\theta+\\cos^2\\theta=1", "variables": "θ", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Divide through for the tan and cot versions.", "active": "True"},
{"formula_id": "MA031", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — trigonometry", "name": "Double angle formulae", "formula": "sin 2θ = 2 sin θ cos θ;  cos 2θ = cos²θ − sin²θ", "latex": "\\sin2\\theta=2\\sin\\theta\\cos\\theta,\\quad \\cos2\\theta=\\cos^2\\theta-\\sin^2\\theta", "variables": "θ", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "cos 2θ has three equivalent forms.", "active": "True"},
{"formula_id": "MA032", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — trigonometry", "name": "Compound angle formulae", "formula": "sin(A ± B) = sin A cos B ± cos A sin B", "latex": "\\sin(A\\pm B)=\\sin A\\cos B\\pm\\cos A\\sin B", "variables": "A, B", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "", "active": "True"},
{"formula_id": "MA033", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — calculus", "name": "Chain rule", "formula": "dy/dx = dy/du × du/dx", "latex": "\\frac{dy}{dx}=\\frac{dy}{du}\\cdot\\frac{du}{dx}", "variables": "u substitution", "units": "—", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "", "active": "True"},
{"formula_id": "MA034", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — calculus", "name": "Product rule", "formula": "d/dx(uv) = u dv/dx + v du/dx", "latex": "\\frac{d}{dx}(uv)=u\\frac{dv}{dx}+v\\frac{du}{dx}", "variables": "u, v functions of x", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "", "active": "True"},
{"formula_id": "MA035", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — calculus", "name": "Quotient rule", "formula": "d/dx(u/v) = (v du/dx − u dv/dx) / v²", "latex": "\\frac{d}{dx}\\!\\left(\\frac{u}{v}\\right)=\\frac{v\\frac{du}{dx}-u\\frac{dv}{dx}}{v^2}", "variables": "u, v functions of x", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Numerator order matters.", "active": "True"},
{"formula_id": "MA036", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — calculus", "name": "Integration by parts", "formula": "∫u dv/dx dx = uv − ∫v du/dx dx", "latex": "\\int u\\frac{dv}{dx}\\,dx=uv-\\int v\\frac{du}{dx}\\,dx", "variables": "u, v", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Choose u by LIATE.", "active": "True"},
{"formula_id": "MA037", "subject": "maths", "level": "A-level", "tier": "", "topic": "Pure — numerical", "name": "Trapezium rule", "formula": "∫y dx ≈ h/2 [(y₀ + yₙ) + 2(y₁ + … + yₙ₋₁)]", "latex": "\\int_a^b y\\,dx\\approx\\tfrac{h}{2}\\big[(y_0+y_n)+2(y_1+\\cdots+y_{n-1})\\big]", "variables": "h strip width, n strips", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "h = (b − a)/n.", "active": "True"},
{"formula_id": "MA038", "subject": "maths", "level": "A-level", "tier": "", "topic": "Statistics", "name": "Variance and standard deviation", "formula": "σ² = Σ(x − x̄)²/n = Σx²/n − x̄²", "latex": "\\sigma^2=\\frac{\\sum(x-\\bar{x})^2}{n}=\\frac{\\sum x^2}{n}-\\bar{x}^2", "variables": "x values, x̄ mean, n count", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Divide by n−1 for a sample estimate.", "active": "True"},
{"formula_id": "MA039", "subject": "maths", "level": "A-level", "tier": "", "topic": "Statistics", "name": "Binomial distribution", "formula": "P(X = r) = nCr p^r (1 − p)^(n−r)", "latex": "P(X=r)=\\binom{n}{r}p^r(1-p)^{n-r}", "variables": "n trials, p success probability", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "Mean np, variance np(1−p).", "active": "True"},
{"formula_id": "MA040", "subject": "maths", "level": "A-level", "tier": "", "topic": "Statistics", "name": "Normal distribution standardising", "formula": "Z = (X − μ) ÷ σ", "latex": "Z=\\frac{X-\\mu}{\\sigma}", "variables": "μ mean, σ standard deviation", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "", "active": "True"},
{"formula_id": "MA041", "subject": "maths", "level": "A-level", "tier": "", "topic": "Statistics", "name": "Conditional probability", "formula": "P(A|B) = P(A ∩ B) ÷ P(B)", "latex": "P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)}", "variables": "P(A∩B), P(B)", "units": "—", "given_aqa": "given", "given_edexcel": "given", "given_ocr": "given", "must_learn": "False", "notes": "", "active": "True"},
{"formula_id": "MA042", "subject": "maths", "level": "A-level", "tier": "", "topic": "Mechanics", "name": "SUVAT — v = u + at", "formula": "v = u + at", "latex": "v=u+at", "variables": "u initial velocity, v final, a acceleration, t time", "units": "m/s, m/s^2, s", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Constant acceleration only.", "active": "True"},
