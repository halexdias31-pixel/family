{"formula_id": "MA045", "subject": "maths", "level": "A-level", "tier": "", "topic": "Mechanics", "name": "Newton's second law", "formula": "F = ma", "latex": "F=ma", "variables": "F resultant force, m mass, a acceleration", "units": "N", "given_aqa": "learn", "given_edexcel": "learn", "given_ocr": "learn", "must_learn": "True", "notes": "Resultant force, not any force.", "active": "True"},
