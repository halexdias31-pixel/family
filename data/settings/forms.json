{
 "notes": "84a: the one form maker's specs; js/form.js FORM_SPECS copies kinds, rules and cards (check-forms.js). leftovers: raw input/select/textarea an app file may still draw outside the maker; budgets only go down (tools/one-form.js holds them; 21 Nov: cards-render 15 and racer 1 were found over and written down as they stand).",
 "kinds": [
  "text",
  "number",
  "money",
  "choice",
  "toggle",
  "date",
  "time",
  "picture",
  "list",
  "pin",
  "slider",
  "phone",
  "file",
  "tick",
  "hidden",
  "long",
  "ticks",
  "toggles",
  "search",
  "timetable",
  "many",
  "doc",
  "head",
  "subjects",
  "shelf",
  "dob",
  "shown"
 ],
 "rules": [
  {
   "kind": "list",
   "match": "^(qual_\\d+|job_\\d+|lib\\d+_|photo_\\d+)|^video$|^venues_ok$"
  },
  {
   "kind": "picture",
   "match": "^photo$"
  },
  {
   "kind": "toggle",
   "match": "^(dbs|active|listed|is_|has_|allow|paid|trackable|stealable)"
  },
  {
   "kind": "date",
   "match": "_date$|^date_of_birth$|^dob_[dmy]$"
  },
  {
   "kind": "time",
   "match": "^(m|tu|w|th|f|sa|su)\\d\\d$"
  },
  {
   "kind": "money",
   "match": "rate|price|cost|fee|seat_cut"
  },
  {
   "kind": "number",
   "match": "hours|km|fraction|pages|year|students|days|weeks|count|level_required|age_|_cut$"
  },
  {
   "kind": "choice",
   "match": "^(borough|city|town|focus|favourite_colour)$"
  },
  {
   "kind": "text",
   "match": ""
  }
 ],
 "cards": {
  "signing-in": {
   "title": "Signing in",
   "ask": "pin-change",
   "said": "pin-said"
  }
 },
