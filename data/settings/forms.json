{
 "notes": "84a: the one form maker's specs; js/form.js FORM_SPECS copies kinds, rules and cards (check-forms.js). leftovers: raw input/select/textarea an app file may still draw outside the maker; budgets only go down.",
 "kinds": [
  "text",
  "number",
  "money",
  "choice",
  "toggle",
  "date",
  "time",
  "picture",
  "list",
  "pin",
  "slider",
  "phone",
  "file",
  "tick",
  "hidden",
  "long",
  "ticks",
  "toggles",
  "search",
  "timetable",
  "many",
  "doc",
  "head",
  "subjects",
  "shelf",
  "dob"
 ],
 "rules": [
  {
   "kind": "list",
   "match": "^(qual_\\d+|job_\\d+|lib\\d+_|photo_\\d+)|^video$|^venues_ok$"
  },
  {
   "kind": "picture",
   "match": "^photo$"
  },
  {
   "kind": "toggle",
   "match": "^(dbs|active|listed|is_|has_|allow|paid|trackable|stealable)"
  },
  {
   "kind": "date",
   "match": "_date$|^date_of_birth$|^dob_[dmy]$"
  },
  {
   "kind": "time",
   "match": "^(m|tu|w|th|f|sa|su)\\d\\d$"
  },
  {
   "kind": "money",
   "match": "rate|price|cost|fee|seat_cut"
  },
  {
   "kind": "choice",
   "match": "^(borough|city|town|focus|favourite_colour|school_year)$"
  },
  {
   "kind": "number",
   "match": "hours|km|fraction|pages|year|students|days|weeks|count|level_required|age_|_cut$"
  },
  {
   "kind": "text",
   "match": ""
  }
 ],
 "cards": {
  "signing-in": {
   "title": "Signing in",
   "boxes": [
    {
     "id": "pin-now",
     "kind": "pin",
     "label": "current PIN",
     "ph": "current PIN"
    },
    {
     "id": "pin-new",
     "kind": "pin",
     "label": "new PIN, 4 numbers, not 1234",
     "ph": "new PIN, 4 numbers"
    },
    {
     "id": "pin-again",
     "kind": "pin",
     "label": "new PIN again",
     "ph": "new PIN again"
    }
   ],
   "save": {
    "icon": "save",
    "label": "Save",
    "note": "your new PIN",
    "act": "pin-save"
   },
   "said": "pin-said"
  }
 },
 "leftovers": {
  "cards-render.js": {
   "n": 14
  },
  "keypad-pad.js": {
   "n": 1
  },
  "book-rows.js": {
   "n": 1
  },
  "tiles.js": {
   "n": 1
  }
 },
 "forms": {
  "say": "FORMS FROM THE ITEM SHAPE (foundation 2): a form is an item kind (item-shape.json) plus this field list: which fields, their order, type (a FORM kind), caption or placeholder, and `may` (a may_() word) for who sees it; money fields also need may_('prices'), so a child never sees a price. `draft`: \"form\" keeps each box a draft until saved (the handler drops it on success), \"set\" is Settings' own (fieldHtml), false none. `fields`: a list, or \"groups\"/\"list\" for names the backend sends, typed by `rules`. `{x}` in a name is o.vars.x. Drawn by formOf_ (js/form.js) through renderCard's field/control blocks.",
  "person-add": {
   "item": "person",
   "attr": "data-pa",
   "fields": [
    {
     "f": "first",
     "type": "text",
     "ph": "First name"
    },
    {
     "f": "last",
     "type": "text",
     "ph": "Last name"
    },
    {
     "f": "role",
     "type": "choice",
     "label": "Role",
     "draft": false
    },
    {
     "f": "email",
     "type": "text",
     "input": "email",
     "ph": "Email",
     "phKid": "Email (optional)"
    },
    {
     "f": "dob",
     "type": "date",
     "label": "Date of birth (optional)"
    }
   ],
   "draft": "form"
  },
  "person-form": {
   "item": "person",
   "attr": "data-pf",
   "fields": [
    {
     "f": "first",
     "type": "text",
     "ph": "First name",
     "row": "names"
    },
    {
     "f": "last",
     "type": "text",
     "ph": "Last name",
     "row": "names"
    },
    {
     "f": "roles",
     "type": "ticks",
     "attr": "data-pf-role",
     "label": "Role",
     "look": "pf-roles",
     "tickLook": ""
    },
    {
     "f": "email",
     "type": "text",
     "input": "email",
     "ph": "Email (optional)"
    },
    {
     "f": "dob",
     "type": "date",
     "label": "Date of birth (optional)"
    },
    {
     "f": "parents",
     "type": "ticks",
     "attr": "data-pf-parent",
     "label": "Parents",
     "draft": false,
     "look": "pf-ticks",
     "tickLook": ""
    },
    {
     "f": "parent",
     "type": "choice",
     "label": "Their parent (optional)",
     "draft": false
    }
   ],
   "draft": "form"
  },
  "person-edit": {
   "item": "person",
   "attr": "data-pe",
   "fields": [
    {
     "f": "first_name",
     "type": "text"
    },
    {
     "f": "last_name",
     "type": "text"
    },
    {
     "f": "handle",
     "type": "text",
     "label": "handle (theirs to change)",
     "readonly": true
    },
    {
     "f": "dob",
     "type": "date",
     "label": "date of birth"
    },
    {
     "f": "email",
     "type": "text",
     "input": "email"
    },
    {
     "f": "phone",
     "type": "phone",
     "input": "tel"
    },
    {
     "f": "address",
     "type": "text"
    },
    {
     "f": "postcode",
     "type": "text"
    }
   ],
   "draft": "form"
  },
  "settings": {
   "item": "person",
   "attr": "data-me",
   "draft": "set",
   "fields": "groups",
   "say": "Settings cards: the backend's field groups; a timetable group is the week grid, lib/qual/job/photo names their shelves, dob_* the three boxes, phone the code and number, photo the picture."
  },
  "card-edit": {
   "item": "tutor",
   "attr": "data-me",
   "draft": false,
   "fields": "list",
   "say": "the tutor card's edit form (cardEditForm_): its sections' names, typed by rules; a price only for may_('prices')."
  },
  "card-seat": {
   "item": "tutor",
   "attr": "data-pound",
   "draft": false,
   "say": "the extra seat in pounds, kept as the share in the hidden twin; @family.'s share only for an admin.",
   "fields": [
    {
     "f": "extra_seat_rate",
     "type": "money"
    },
    {
     "f": "extra_seat_rate",
     "type": "hidden",
     "attr": "data-me"
    },
    {
     "f": "extra_seat_cut",
     "type": "money",
     "may": "admin"
    },
    {
     "f": "extra_seat_cut",
     "type": "hidden",
     "attr": "data-me",
     "may": "admin"
    }
   ]
  },
  "card-where": {
   "item": "tutor",
   "attr": "data-me",
   "draft": false,
   "say": "Where you teach: an area a tick, rewriting the hidden venues_ok, saved by the card's Save.",
   "fields": [
    {
     "f": "venues_ok",
     "type": "hidden"
    },
    {
     "f": "areas",
     "type": "ticks",
     "attr": "data-where-area",
     "label": "Areas you teach in",
     "look": "many-list where-areas"
    }
   ]
  },
  "library-card": {
   "item": "person",
   "attr": "data-me",
   "draft": "set",
   "say": "one library card on the shelf; a library PIN is not a sign-in PIN and keeps no draft (setDraftOk_).",
   "fields": [
    {
     "f": "lib{n}_name",
     "type": "text",
     "ph": "Library name",
     "look": "lib-name",
     "quiet": true
    },
    {
     "f": "lib{n}_pin",
     "type": "text",
     "label": "PIN",
     "look": "lib-pin",
     "quiet": true,
     "blank": true
    },
    {
     "f": "lib{n}_no",
     "type": "text",
     "ph": "Card number",
     "look": "lib-no",
     "quiet": true
    }
   ]
  },
  "job": {
   "item": "person",
   "attr": "data-me",
   "draft": "set",
   "say": "one job on the shelf: role, where, from–to.",
   "fields": [
    {
     "f": "job_{n}_role",
     "type": "text",
     "ph": "role",
     "max": 80
    },
    {
     "f": "job_{n}_where",
     "type": "text",
     "ph": "where",
     "max": 80
    },
    {
     "f": "job_{n}_from",
     "type": "text",
     "ph": "from",
     "max": 80
    },
    {
     "f": "job_{n}_to",
     "type": "text",
     "ph": "to, or now",
     "max": 80
    }
   ]
  },
  "dob": {
   "item": "person",
   "attr": "data-me",
   "draft": "set",
   "say": "a date of birth as three boxes.",
   "fields": [
    {
     "f": "dob_d",
     "type": "text",
     "ph": "DD",
     "max": 2,
     "pad": "numeric"
    },
    {
     "f": "dob_m",
     "type": "text",
     "ph": "MM",
     "max": 2,
     "pad": "numeric"
    },
    {
     "f": "dob_y",
     "type": "text",
     "ph": "YYYY",
     "max": 4,
     "pad": "numeric"
    }
   ]
  },
  "family-pick": {
   "item": "person",
   "attr": "data-fam-q",
   "draft": false,
   "say": "a family picker: a name looked up, not work, retyped in a second.",
   "fields": [
    {
     "f": "{scope}",
     "type": "search",
     "ph": "name or @handle",
     "want": "{want}"
    }
   ]
  },
  "notify": {
   "item": "person",
   "attr": "data-do",
   "draft": false,
   "say": "Notifications: each tick a setNotify the moment it is ticked (formToggle_).",
   "fields": [
    {
     "f": "kinds",
     "type": "toggles"
    }
   ]
  },
