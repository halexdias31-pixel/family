{
 "notes": "84a: the one form maker's specs; js/form.js FORM_SPECS copies kinds, rules and cards (check-forms.js). leftovers: raw input/select/textarea an app file may still draw outside the maker; budgets only go down.",
 "kinds": [
  "text",
  "number",
  "money",
  "choice",
  "toggle",
  "date",
  "time",
  "picture",
  "list",
  "pin",
  "slider",
  "phone",
  "file",
  "tick",
  "hidden"
 ],
 "rules": [
  {
   "kind": "list",
   "match": "^(qual_\\d+|job_\\d+|lib\\d+_|photo_\\d+)|^video$|^venues_ok$"
  },
  {
   "kind": "picture",
   "match": "^photo$"
  },
  {
   "kind": "toggle",
   "match": "^(dbs|active|listed|is_|has_|allow|paid|trackable|stealable)"
  },
  {
   "kind": "date",
   "match": "_date$|^date_of_birth$|^dob_[dmy]$"
  },
  {
   "kind": "time",
   "match": "^(m|tu|w|th|f|sa|su)\\d\\d$"
  },
  {
   "kind": "money",
   "match": "rate|price|cost|fee"
  },
  {
   "kind": "number",
   "match": "hours|km|fraction|pages|year|students|days|weeks|count|level_required|age_|_cut$"
  },
  {
   "kind": "choice",
   "match": "^(borough|city|town|focus|favourite_colour)$"
  },
  {
   "kind": "text",
   "match": ""
  }
 ],
 "cards": {
  "signing-in": {
   "title": "Signing in",
   "boxes": [
    {
     "id": "pin-now",
     "kind": "pin",
     "label": "current PIN",
     "ph": "current PIN"
    },
    {
     "id": "pin-new",
     "kind": "pin",
     "label": "new PIN, 4 numbers, not 1234",
     "ph": "new PIN, 4 numbers"
    },
    {
     "id": "pin-again",
     "kind": "pin",
     "label": "new PIN again",
     "ph": "new PIN again"
    }
   ],
   "save": {
    "icon": "save",
    "label": "Save",
    "note": "your new PIN",
    "act": "pin-save"
   },
   "said": "pin-said"
  }
 },
 "leftovers": {
  "cards-render.js": {
   "n": 14
  },
  "keypad-pad.js": {
   "n": 1
  },
  "book-rows.js": {
   "n": 1
  },
  "tiles.js": {
   "n": 1
  }
 },
 "forms": {
  "say": "FORMS FROM THE ITEM SHAPE (foundation 2): a form is an item kind (item-shape.json) plus this field list: which fields, their order, type (a FORM kind), caption or placeholder, and `may` (a may_() word) for who sees it; money fields also need may_('prices'). Drawn by formOf_ (js/form.js) through renderCard's field/control blocks.",
  "person-add": {
   "item": "person",
   "attr": "data-pa",
   "fields": [
    {
     "f": "first",
     "type": "text",
     "ph": "First name"
    },
    {
     "f": "last",
     "type": "text",
     "ph": "Last name"
    },
    {
     "f": "role",
     "type": "choice",
     "label": "Role"
    },
    {
     "f": "email",
     "type": "text",
     "input": "email",
     "ph": "Email",
     "phKid": "Email (optional)"
    },
    {
     "f": "dob",
     "type": "date",
     "label": "Date of birth (optional)"
    }
   ]
  },
  "person-form": {
   "item": "person",
   "attr": "data-pf",
   "fields": [
    {
     "f": "first",
     "type": "text",
     "ph": "First name",
     "row": "names"
    },
    {
     "f": "last",
     "type": "text",
     "ph": "Last name",
     "row": "names"
    },
    {
     "f": "email",
     "type": "text",
     "input": "email",
     "ph": "Email (optional)"
    },
    {
     "f": "dob",
     "type": "date",
     "label": "Date of birth (optional)"
    }
   ]
  },
  "person-edit": {
   "item": "person",
   "attr": "data-pe",
   "fields": [
    {
     "f": "first_name",
     "type": "text"
    },
    {
     "f": "last_name",
     "type": "text"
    },
    {
     "f": "handle",
     "type": "text",
     "label": "handle (theirs to change)",
     "readonly": true
    },
    {
     "f": "dob",
     "type": "date",
     "label": "date of birth"
    },
    {
     "f": "email",
     "type": "text",
     "input": "email"
    },
    {
     "f": "phone",
     "type": "phone",
     "input": "tel"
    },
    {
     "f": "address",
     "type": "text"
    },
    {
     "f": "postcode",
     "type": "text"
    }
   ]
  }
 }
}
