{
 "notes": "84a: the one form maker's specs; js/form.js FORM_SPECS copies kinds, rules and cards (check-forms.js). leftovers: raw input/select/textarea a Settings file may still draw outside the maker; budgets only go down.",
 "kinds": [
  "text",
  "number",
  "money",
  "choice",
  "toggle",
  "date",
  "time",
  "picture",
  "list",
  "pin",
  "slider",
  "phone",
  "file",
  "tick",
  "hidden"
 ],
 "rules": [
  {
   "kind": "list",
   "match": "^(qual_\\d+|job_\\d+|lib\\d+_|photo_\\d+)|^video$|^venues_ok$"
  },
  {
   "kind": "picture",
   "match": "^photo$"
  },
  {
   "kind": "toggle",
   "match": "^(dbs|active|listed|is_|has_|allow|paid|trackable|stealable)"
  },
  {
   "kind": "date",
   "match": "_date$|^date_of_birth$|^dob_[dmy]$"
  },
  {
   "kind": "time",
   "match": "^(m|tu|w|th|f|sa|su)\\d\\d$"
  },
  {
   "kind": "money",
   "match": "rate|price|cost|fee"
  },
  {
   "kind": "number",
   "match": "hours|km|fraction|pages|year|students|days|weeks|count|level_required|age_|_cut$"
  },
  {
   "kind": "choice",
   "match": "^(borough|city|town|focus|favourite_colour)$"
  },
  {
   "kind": "text",
   "match": ""
  }
 ],
 "cards": {
  "signing-in": {
   "title": "Signing in",
   "boxes": [
    {
     "id": "pin-now",
     "kind": "pin",
     "label": "current PIN",
     "ph": "current PIN"
    },
    {
     "id": "pin-new",
     "kind": "pin",
     "label": "new PIN, 4 to 8 numbers, not 1234",
     "ph": "new PIN, 4–8 numbers"
    },
    {
     "id": "pin-again",
     "kind": "pin",
     "label": "new PIN again",
     "ph": "new PIN again"
    }
   ],
   "save": {
    "icon": "save",
    "label": "Save",
    "note": "your new PIN",
    "act": "pin-save"
   },
   "said": "pin-said"
  }
 },
 "leftovers": {}
}
