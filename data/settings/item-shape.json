{
  "say": "THE ONE ITEM SHAPE (owner, 14 Nov, step 1). Every item of every kind is stored and loaded as these six fields, through item_(raw, kind) in js/cards-parts.js, and drawn through cardOfItem_(item). Read as docs/item-shape.md; held by js/check-item-shape.js.",
  "shape": {
    "id": { "type": "string", "required": true, "say": "The item's own id, never reused (MS-0001, EV-0301 ...)." },
    "kind": { "type": "string", "required": true, "say": "Which kind of item it is: one of `kinds` below." },
    "name": { "type": "string", "required": true, "say": "What it is called; the card's first tag." },
    "tags": { "type": "string[]", "required": true, "say": "Its own words (language, era, genre ...), for search, tag cards and topic pages." },
    "body": { "type": "block[]", "required": true, "say": "What it says, as renderCard blocks ({ type, ... }); may be empty." },
    "links": { "type": "string[]", "required": true, "say": "Ids of other items it points at (a manuscript's writings, an event's figures)." }
  },
  "kinds": {
    "manuscript": { "source": "data/manuscripts.json", "loader": "js/library.js HIST_DB -> find-history.js histItem_", "builder": "item map (cards-parts.js ITEM_MAPS)" },
    "writing": { "source": "data/writings.json", "loader": "js/library.js HIST_DB -> find-history.js histItem_", "builder": "item map (cards-parts.js ITEM_MAPS)" },
    "event": { "source": "data/timeline.json", "loader": "js/library.js HIST_DB -> find-history.js histItem_", "builder": "item map (cards-parts.js ITEM_MAPS)" },
    "figure": { "source": "data/figures.json (+ portraits.json)", "loader": "js/library.js HIST_DB -> histItem_ as kind people", "builder": "find-boxers.js cardKind_('people')" },
    "boxer": { "source": "data/boxers.json", "loader": "js/library.js libExtrasBoxing_ -> find-aloud.js", "builder": "find-boxers.js cardKind_('people')" },
    "fight": { "source": "data/fights.json", "loader": "js/library.js libExtrasBoxing_ -> find-aloud.js", "builder": "find-facets.js cardKind_('fight')" },
    "practical": { "source": "data/practicals.json + data-private + Ledger lib_practicals", "loader": "js/library.js libPractical_", "builder": "find-facets.js cardKind_('practical')" },
    "project": { "source": "data/projects.json + data-private + Ledger lib_projects", "loader": "js/library.js libProject_", "builder": "find-facets.js cardKind_('project')" },
    "content": { "source": "data/textbooks.json + Ledger lib_content", "loader": "js/library.js -> find-facets.js", "builder": "find-facets.js cardKind_('content')" },
    "insert": { "source": "data/inserts.json + Ledger lib_inserts", "loader": "js/library.js -> find-history.js", "builder": "find-history.js cardKind_('insert')" },
    "spec": { "source": "data/specs.json", "loader": "js/library.js -> find-history.js", "builder": "find-history.js cardKind_('spec')" },
    "chem": { "source": "data/chemistry/*.json", "loader": "js/chemistry.js", "builder": "chemistry.js cardKind_('chem')" },
    "mech": { "source": "data/mechanics/*.json", "loader": "js/mechanics.js", "builder": "mechanics.js cardKind_('mech')" },
    "question": { "source": "data/questions.json + data-private + Ledger lib_questions", "loader": "js/data.js, js/library.js", "builder": "find-figures.js cardKind_('question')" },
    "subject": { "source": "payload (Ledger people/pricing)", "loader": "subjectRows() -> find-aloud.js", "builder": "cards-parts.js cardKind_('subject')" },
    "level": { "source": "payload (Ledger people/pricing)", "loader": "find-aloud.js", "builder": "cards-parts.js cardKind_('level')" },
    "venue": { "source": "Ledger venues + rooms tabs (data/settings/venues.json)", "loader": "payload -> find-aloud.js", "builder": "cards-parts.js cardKind_('venue')" },
    "tutor": { "source": "Ledger people tab (role tutor)", "loader": "payload -> find-aloud.js", "builder": "cards-people.js cardKind_('tutor')" },
    "person": { "source": "Ledger people tab", "loader": "payload -> find-doors.js", "builder": "find-doors.js cardKind_('person')" },
    "booking": { "source": "Ledger events + receipts tabs", "loader": "backend booking.gs -> book-*.js", "builder": "cards-render.js paperRow_ (booking paper)" },
    "product": { "source": "Ledger shop tab (data/settings/shop.json, data/shop-additions.json)", "loader": "backend get-shop.gs -> find-aloud.js", "builder": "widget cards (find-aloud.js)" },
    "post": { "source": "Ledger posts tabs", "loader": "backend get-posts.gs -> find-doors.js", "builder": "me-shelves.js / find-finder.js" }
  },
  "migrated": ["manuscript", "writing", "event"]
}
