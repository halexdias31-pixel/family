 {
  "insert_id": "INS-GCSE-PHYSICS",
  "name": "GCSE Physics equation sheet",
  "summary": "The equations a GCSE Physics or Combined Science candidate is given in the exam, 2025 to 2027.",
  "subject": "Physics",
  "level": "GCSE",
  "keystage": "KS4",
  "board": "AQA, Edexcel, OCR",
  "tier": "Foundation, Higher",
  "for_subjects": "Physics, Combined Science",
  "for_levels": "GCSE",
  "for_tiers": "",
  "verified": "False",
  "verified_note": "The equations in the DfE GCSE physics content, which AQA, Edexcel and OCR each print on their own 2025 to 2027 sheet in their own order and words. H marks Higher tier; “Physics only” marks one not asked in Combined Science. Not yet compared line by line with each board’s PDF, so marked unverified.",
  "official": [
   {
    "label": "AQA sheets, 2025 to 2027",
    "url": "https://www.aqa.org.uk/news/gcse-maths-and-gcse-sciences-formulae-and-equation-sheets-for-2025-2027"
   },
   {
    "label": "OCR sheets, 2025 to 2027",
    "url": "https://www.ocr.org.uk/administration/support-and-tools/subject-updates/formulae-equation-sheets-723889/"
   },
   {
    "label": "Edexcel GCSE sciences",
    "url": "https://qualifications.pearson.com/en/qualifications/edexcel-gcses/sciences-2016.html"
   }
  ],
  "sections": [
   {
    "head": "Forces and motion",
    "lines": [
     {
      "name": "Weight",
      "math": "weight = mass &times; gravitational field strength &nbsp; <i>W</i> = <i>m</i><i>g</i>"
     },
     {
      "name": "Work done",
      "math": "work done = force &times; distance along the line of the force &nbsp; <i>W</i> = <i>F</i><i>s</i>"
     },
     {
      "name": "Hooke’s law",
      "math": "force = spring constant &times; extension &nbsp; <i>F</i> = <i>k</i><i>e</i>"
     },
     {
      "name": "Moment",
      "math": "moment = force &times; perpendicular distance from the pivot &nbsp; <i>M</i> = <i>F</i><i>d</i>",
      "only": "Physics"
     },
     {
      "name": "Pressure",
      "math": "pressure = <sup>force normal to a surface</sup>&frasl;<sub>area</sub> &nbsp; <i>p</i> = <sup><i>F</i></sup>&frasl;<sub><i>A</i></sub>",
      "only": "Physics"
     },
     {
      "name": "Pressure in a liquid",
      "math": "pressure = column height &times; density &times; <i>g</i> &nbsp; <i>p</i> = <i>h</i>&rho;<i>g</i>",
      "higher": "True",
      "only": "Physics"
     },
     {
      "name": "Speed",
      "math": "distance = speed &times; time &nbsp; <i>s</i> = <i>v</i><i>t</i>"
     },
     {
      "name": "Acceleration",
      "math": "acceleration = <sup>change in velocity</sup>&frasl;<sub>time taken</sub> &nbsp; <i>a</i> = <sup>&Delta;<i>v</i></sup>&frasl;<sub><i>t</i></sub>"
     },
     {
      "name": "Uniform acceleration",
      "math": "<i>v</i><sup>2</sup> &minus; <i>u</i><sup>2</sup> = 2<i>a</i><i>s</i>",
      "note": "v the final velocity, u the initial velocity, s the distance"
     },
     {
      "name": "Newton’s second law",
      "math": "force = mass &times; acceleration &nbsp; <i>F</i> = <i>m</i><i>a</i>"
     },
     {
      "name": "Momentum",
      "math": "momentum = mass &times; velocity &nbsp; <i>p</i> = <i>m</i><i>v</i>",
      "higher": "True"
     },
     {
      "name": "Force and momentum",
      "math": "force = <sup>change in momentum</sup>&frasl;<sub>time taken</sub> &nbsp; <i>F</i> = <sup><i>m</i>&Delta;<i>v</i></sup>&frasl;<sub>&Delta;<i>t</i></sub>",
      "higher": "True",
      "only": "Physics"
     }
    ]
   },
   {
    "head": "Energy",
    "lines": [
     {
      "name": "Kinetic energy",
      "math": "<i>E</i><sub>k</sub> = <sup>1</sup>&frasl;<sub>2</sub> <i>m</i><i>v</i><sup>2</sup>"
     },
     {
      "name": "Gravitational potential energy",
      "math": "<i>E</i><sub>p</sub> = <i>m</i><i>g</i><i>h</i>"
     },
     {
      "name": "Elastic potential energy",
      "math": "<i>E</i><sub>e</sub> = <sup>1</sup>&frasl;<sub>2</sub> <i>k</i><i>e</i><sup>2</sup>",
      "note": "while the limit of proportionality is not passed"
     },
     {
      "name": "Specific heat capacity",
      "math": "&Delta;<i>E</i> = <i>m</i><i>c</i>&Delta;&theta;",
      "note": "thermal energy change = mass × specific heat capacity × temperature change"
     },
     {
      "name": "Specific latent heat",
      "math": "<i>E</i> = <i>m</i><i>L</i>",
      "note": "energy for a change of state = mass × specific latent heat"
     },
     {
      "name": "Power from energy",
      "math": "<i>P</i> = <sup><i>E</i></sup>&frasl;<sub><i>t</i></sub>"
     },
     {
      "name": "Power from work",
      "math": "<i>P</i> = <sup><i>W</i></sup>&frasl;<sub><i>t</i></sub>"
     },
     {
      "name": "Efficiency",
      "math": "efficiency = <sup>useful output energy transfer</sup>&frasl;<sub>total input energy transfer</sub> = <sup>useful power output</sup>&frasl;<sub>total power input</sub>"
     }
    ]
   },
   {
    "head": "Electricity and magnetism",
    "lines": [
     {
      "name": "Charge",
      "math": "<i>Q</i> = <i>I</i><i>t</i>",
      "note": "charge = current × time"
     },
     {
      "name": "Potential difference",
      "math": "<i>V</i> = <i>I</i><i>R</i>",
      "note": "potential difference = current × resistance"
     },
     {
      "name": "Electrical power",
      "math": "<i>P</i> = <i>V</i><i>I</i> = <i>I</i><sup>2</sup><i>R</i>"
     },
     {
      "name": "Energy from power",
      "math": "<i>E</i> = <i>P</i><i>t</i>"
     },
     {
      "name": "Energy from charge",
      "math": "<i>E</i> = <i>Q</i><i>V</i>"
     },
     {
      "name": "Force on a wire",
      "math": "<i>F</i> = <i>B</i><i>I</i><i>l</i>",
      "higher": "True",
      "note": "force = magnetic flux density × current × length"
     },
     {
      "name": "Transformer turns",
      "math": "<sup><i>V</i><sub>p</sub></sup>&frasl;<sub><i>V</i><sub>s</sub></sub> = <sup><i>n</i><sub>p</sub></sup>&frasl;<sub><i>n</i><sub>s</sub></sub>",
      "higher": "True",
      "only": "Physics"
     },
     {
      "name": "Transformer power",
      "math": "<i>V</i><sub>s</sub><i>I</i><sub>s</sub> = <i>V</i><sub>p</sub><i>I</i><sub>p</sub>",
      "note": "a transformer that wastes no energy"
     }
    ]
   },
   {
    "head": "Matter and waves",
    "lines": [
     {
      "name": "Density",
      "math": "&rho; = <sup><i>m</i></sup>&frasl;<sub><i>V</i></sub>"
     },
     {
      "name": "Gas at constant temperature",
      "math": "<i>p</i><i>V</i> = constant",
      "only": "Physics"
     },
     {
      "name": "Wave speed",
      "math": "<i>v</i> = <i>f</i>&lambda;"
     },
     {
      "name": "Period",
      "math": "<i>T</i> = <sup>1</sup>&frasl;<sub><i>f</i></sub>"
     },
     {
      "name": "Magnification",
      "math": "magnification = <sup>image height</sup>&frasl;<sub>object height</sub>",
      "only": "Physics"
     }
    ]
   }
  ],
  "table": "",
  "active": "True"
 },
