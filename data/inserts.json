  "insert_id": "INS-GCSE-MATHS-F",
  "name": "GCSE Maths formulae sheet (Foundation)",
  "summary": "The formulae a GCSE Maths Foundation candidate is given in the exam, 2025 to 2027.",
  "subject": "Maths",
  "level": "GCSE",
  "keystage": "KS4",
  "board": "AQA, Edexcel, OCR",
  "tier": "Foundation",
  "for_subjects": "Maths",
  "for_levels": "GCSE",
  "for_tiers": "Foundation",
  "verified": "False",
  "verified_note": "Every board gives the same list, the one the November 2024 Ofqual and DfE decision set for 2025 to 2027; checked against that list as the boards’ guides and the Edexcel June 2025 exam aid set it out. Not yet compared line by line with each board’s own PDF, so marked unverified. A formula a question prints, like the volume of a cone, is still printed in the question.",
  "official": [
   {
    "label": "Edexcel exam aid, Foundation",
    "url": "https://qualifications.pearson.com/content/dam/pdf/GCSE/mathematics/2015/teaching-and-learning-materials/gcse-mathematics-1ma1-exam-aid-1f2f3f-june2025.pdf"
   },
   {
    "label": "Edexcel exam aid, Higher",
    "url": "https://qualifications.pearson.com/content/dam/pdf/GCSE/mathematics/2015/teaching-and-learning-materials/gcse-mathematics-1ma1-exam-aid-1h2h3h-june2025.pdf"
   },
   {
    "label": "AQA sheets, 2025 to 2027",
    "url": "https://www.aqa.org.uk/news/gcse-maths-and-gcse-sciences-formulae-and-equation-sheets-for-2025-2027"
   },
   {
    "label": "OCR sheets, 2025 to 2027",
    "url": "https://www.ocr.org.uk/administration/support-and-tools/subject-updates/formulae-equation-sheets-723889/"
   }
  ],
  "sections": [
   {
    "head": "Area and volume",
    "lines": [
     {
      "name": "Area of a trapezium",
      "math": "Area = <sup>1</sup>&frasl;<sub>2</sub> (<i>a</i> + <i>b</i>)<i>h</i>"
     },
     {
      "name": "Volume of a prism",
      "math": "Volume = area of cross-section &times; length"
     },
     {
      "name": "Circle: circumference",
      "math": "<i>C</i> = &pi;<i>d</i> = 2&pi;<i>r</i>"
     },
     {
      "name": "Circle: area",
      "math": "<i>A</i> = &pi;<i>r</i><sup>2</sup>"
     }
    ]
   },
   {
    "head": "Right-angled triangles",
    "lines": [
     {
      "name": "Pythagoras’ theorem",
      "math": "<i>a</i><sup>2</sup> + <i>b</i><sup>2</sup> = <i>c</i><sup>2</sup>"
     },
     {
      "name": "Sine",
      "math": "sin <i>x</i> = <sup>opposite</sup>&frasl;<sub>hypotenuse</sub>"
     },
     {
      "name": "Cosine",
      "math": "cos <i>x</i> = <sup>adjacent</sup>&frasl;<sub>hypotenuse</sub>"
     },
     {
      "name": "Tangent",
      "math": "tan <i>x</i> = <sup>opposite</sup>&frasl;<sub>adjacent</sub>"
     }
    ]
   },
   {
    "head": "Money and chance",
    "lines": [
     {
      "name": "Compound interest",
      "math": "Total = <i>P</i> (1 + <sup><i>r</i></sup>&frasl;<sub>100</sub>)<sup><i>n</i></sup>",
      "note": "P the amount at the start, r the percentage rate each period, n the number of periods"
     },
     {
      "name": "Either event",
      "math": "P(<i>A</i> or <i>B</i>) = P(<i>A</i>) + P(<i>B</i>) &minus; P(<i>A</i> and <i>B</i>)"
     },
     {
      "name": "Both events",
      "math": "P(<i>A</i> and <i>B</i>) = P(<i>A</i> given <i>B</i>) &times; P(<i>B</i>)"
     }
    ]
   }
  ],
  "table": "",
  "active": "True"
