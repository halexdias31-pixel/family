 {
  "insert_id": "INS-ALEVEL-MATHS",
  "name": "A level Maths formulae booklet",
  "summary": "The main formulas of the booklet an A level or AS Maths candidate is given in the exam.",
  "subject": "Maths",
  "level": "A-Level, AS",
  "keystage": "KS5",
  "board": "Edexcel, AQA, OCR",
  "tier": "",
  "for_subjects": "Maths",
  "for_levels": "A-Level, Alevel, AS",
  "for_tiers": "",
  "verified": "False",
  "verified_note": "The main formulas of the booklet every A level and AS Maths candidate is given, in our own setting, and not the whole booklet: its tables and the rest are in the board’s own. Each is a standard identity; not yet compared line by line with the booklet, so marked unverified.",
  "official": [
   {
    "label": "Edexcel A level Mathematics: the booklet is under Course materials",
    "url": "https://qualifications.pearson.com/en/qualifications/edexcel-a-levels/mathematics-2017.html"
   },
   {
    "label": "AQA A-level Mathematics 7357",
    "url": "https://www.aqa.org.uk/subjects/mathematics/a-level/mathematics-7357"
   },
   {
    "label": "OCR A Level Mathematics A",
    "url": "https://www.ocr.org.uk/qualifications/as-and-a-level/mathematics-a-h230-h240-from-2017/"
   }
  ],
  "sections": [
   {
    "head": "Algebra and series",
    "lines": [
     {
      "name": "Arithmetic series",
      "math": "<i>S</i><sub><i>n</i></sub> = <sup>1</sup>&frasl;<sub>2</sub> <i>n</i>(<i>a</i> + <i>l</i>) = <sup>1</sup>&frasl;<sub>2</sub> <i>n</i>[2<i>a</i> + (<i>n</i> &minus; 1)<i>d</i>]"
     },
     {
      "name": "Geometric series",
      "math": "<i>S</i><sub><i>n</i></sub> = <sup><i>a</i>(1 &minus; <i>r</i><sup><i>n</i></sup>)</sup>&frasl;<sub>1 &minus; <i>r</i></sub>; &nbsp; <i>S</i><sub>&infin;</sub> = <sup><i>a</i></sup>&frasl;<sub>1 &minus; <i>r</i></sub> for |<i>r</i>| &lt; 1"
     },
     {
      "name": "Binomial, n a positive integer",
      "math": "(<i>a</i> + <i>b</i>)<sup><i>n</i></sup> = <i>a</i><sup><i>n</i></sup> + <sup><i>n</i></sup>C<sub>1</sub> <i>a</i><sup><i>n</i>&minus;1</sup><i>b</i> + &hellip; + <sup><i>n</i></sup>C<sub><i>r</i></sub> <i>a</i><sup><i>n</i>&minus;<i>r</i></sup><i>b</i><sup><i>r</i></sup> + &hellip; + <i>b</i><sup><i>n</i></sup>",
      "note": "nCr = n! ÷ (r!(n − r)!)"
     },
     {
      "name": "Binomial, any n",
      "math": "(1 + <i>x</i>)<sup><i>n</i></sup> = 1 + <i>n</i><i>x</i> + <sup><i>n</i>(<i>n</i> &minus; 1)</sup>&frasl;<sub>2 &times; 1</sub> <i>x</i><sup>2</sup> + &hellip; &nbsp; for |<i>x</i>| &lt; 1"
     },
     {
      "name": "Change of base",
      "math": "log<sub><i>a</i></sub> <i>x</i> = <sup>log<sub><i>b</i></sub> <i>x</i></sup>&frasl;<sub>log<sub><i>b</i></sub> <i>a</i></sub>"
     }
    ]
   },
   {
    "head": "Trigonometry",
    "lines": [
     {
      "name": "Compound angles",
      "math": "sin(<i>A</i> &plusmn; <i>B</i>) = sin <i>A</i> cos <i>B</i> &plusmn; cos <i>A</i> sin <i>B</i>"
     },
     {
      "name": "",
      "math": "cos(<i>A</i> &plusmn; <i>B</i>) = cos <i>A</i> cos <i>B</i> &#8723; sin <i>A</i> sin <i>B</i>"
     },
     {
      "name": "",
      "math": "tan(<i>A</i> &plusmn; <i>B</i>) = <sup>tan <i>A</i> &plusmn; tan <i>B</i></sup>&frasl;<sub>1 &#8723; tan <i>A</i> tan <i>B</i></sub>"
     },
     {
      "name": "Cosine rule",
      "math": "<i>a</i><sup>2</sup> = <i>b</i><sup>2</sup> + <i>c</i><sup>2</sup> &minus; 2<i>b</i><i>c</i> cos <i>A</i>"
     }
    ]
   },
   {
    "head": "Calculus and numerical methods",
    "lines": [
     {
      "name": "Derivatives",
      "math": "tan <i>kx</i> &rarr; <i>k</i> sec<sup>2</sup> <i>kx</i>; &nbsp; sec <i>x</i> &rarr; sec <i>x</i> tan <i>x</i>; &nbsp; cot <i>x</i> &rarr; &minus;cosec<sup>2</sup> <i>x</i>; &nbsp; cosec <i>x</i> &rarr; &minus;cosec <i>x</i> cot <i>x</i>"
     },
     {
      "name": "Quotient rule",
      "math": "d(<i>u</i>/<i>v</i>)/d<i>x</i> = <sup><i>v</i><i>u</i>&prime; &minus; <i>u</i><i>v</i>&prime;</sup>&frasl;<sub><i>v</i><sup>2</sup></sub>"
     },
     {
      "name": "Integration by parts",
      "math": "&int; <i>u</i><i>v</i>&prime; d<i>x</i> = <i>u</i><i>v</i> &minus; &int; <i>v</i><i>u</i>&prime; d<i>x</i>"
     },
     {
      "name": "An integral",
      "math": "&int; tan <i>kx</i> d<i>x</i> = <sup>1</sup>&frasl;<sub><i>k</i></sub> ln|sec <i>kx</i>| + <i>c</i>"
     },
     {
      "name": "Trapezium rule",
      "math": "&int;<sub><i>a</i></sub><sup><i>b</i></sup> <i>y</i> d<i>x</i> &asymp; <sup>1</sup>&frasl;<sub>2</sub> <i>h</i>{(<i>y</i><sub>0</sub> + <i>y</i><sub><i>n</i></sub>) + 2(<i>y</i><sub>1</sub> + &hellip; + <i>y</i><sub><i>n</i>&minus;1</sub>)}",
      "note": "h = (b − a) ÷ n"
     },
     {
      "name": "Newton–Raphson",
      "math": "<i>x</i><sub><i>n</i>+1</sub> = <i>x</i><sub><i>n</i></sub> &minus; <sup>f(<i>x</i><sub><i>n</i></sub>)</sup>&frasl;<sub>f&prime;(<i>x</i><sub><i>n</i></sub>)</sub>"
     }
    ]
   },
   {
    "head": "Statistics and mechanics",
    "lines": [
     {
      "name": "Either event",
      "math": "P(<i>A</i> &cup; <i>B</i>) = P(<i>A</i>) + P(<i>B</i>) &minus; P(<i>A</i> &cap; <i>B</i>)"
     },
     {
      "name": "Conditional probability",
      "math": "P(<i>A</i> | <i>B</i>) = <sup>P(<i>A</i> &cap; <i>B</i>)</sup>&frasl;<sub>P(<i>B</i>)</sub>"
     },
     {
      "name": "Binomial distribution",
      "math": "P(<i>X</i> = <i>x</i>) = <sup><i>n</i></sup>C<sub><i>x</i></sub> <i>p</i><sup><i>x</i></sup>(1 &minus; <i>p</i>)<sup><i>n</i>&minus;<i>x</i></sup>",
      "note": "X ~ B(n, p): mean np, variance np(1 − p)"
     },
     {
      "name": "Standard normal",
      "math": "<i>Z</i> = <sup><i>X</i> &minus; &mu;</sup>&frasl;<sub>&sigma;</sub>",
      "note": "X ~ N(μ, σ²)"
     },
     {
      "name": "Constant acceleration",
      "math": "<i>v</i> = <i>u</i> + <i>a</i><i>t</i>; &nbsp; <i>s</i> = <i>u</i><i>t</i> + <sup>1</sup>&frasl;<sub>2</sub> <i>a</i><i>t</i><sup>2</sup>; &nbsp; <i>s</i> = <sup>1</sup>&frasl;<sub>2</sub> (<i>u</i> + <i>v</i>)<i>t</i>; &nbsp; <i>v</i><sup>2</sup> = <i>u</i><sup>2</sup> + 2<i>a</i><i>s</i>; &nbsp; <i>s</i> = <i>v</i><i>t</i> &minus; <sup>1</sup>&frasl;<sub>2</sub> <i>a</i><i>t</i><sup>2</sup>"
     }
    ]
   }
  ],
  "table": "",
  "active": "True"
 },
 {
  "insert_id": "INS-ALEVEL-PHYSICS",
  "name": "A level Physics data and formulae",
  "summary": "The key constants and equations of the booklet an A level Physics candidate is given in the exam.",
  "subject": "Physics",
  "level": "A-Level",
  "keystage": "KS5",
  "board": "AQA",
  "tier": "",
  "for_subjects": "Physics",
  "for_levels": "A-Level, Alevel",
  "for_tiers": "",
  "verified": "False",
  "verified_note": "The key constants and equations of the data and formulae booklet AQA hands out with every A-level Physics paper, in our own setting; the options, units and particle tables are in the booklet itself. Constants are given to three figures as booklets print them. Not yet compared line by line with the booklet, so marked unverified.",
  "official": [
   {
    "label": "AQA A-level Physics data and formulae booklet",
    "url": "https://www.aqa.org.uk/files/fHDU1dLPgDwvQhfFoKkMzz/ed28d77381e7a4fb02c252226c5fd628639400d8.pdf"
   },
   {
    "label": "Edexcel A level Physics",
    "url": "https://qualifications.pearson.com/en/qualifications/edexcel-a-levels/physics-2015.html"
   },
   {
    "label": "OCR A Level Physics A",
    "url": "https://www.ocr.org.uk/qualifications/as-and-a-level/physics-a-h156-h556-from-2015/"
   }
  ],
  "sections": [
   {
    "head": "Constants",
    "lines": [
     {
      "name": "Speed of light in a vacuum",
      "math": "<i>c</i> = 3.00 &times; 10<sup>8</sup> m s<sup>&minus;1</sup>"
     },
     {
      "name": "Elementary charge",
      "math": "<i>e</i> = 1.60 &times; 10<sup>&minus;19</sup> C"
     },
     {
      "name": "Planck constant",
      "math": "<i>h</i> = 6.63 &times; 10<sup>&minus;34</sup> J s"
     },
     {
      "name": "Gravitational constant",
      "math": "<i>G</i> = 6.67 &times; 10<sup>&minus;11</sup> N m<sup>2</sup> kg<sup>&minus;2</sup>"
     },
     {
      "name": "Avogadro constant",
      "math": "<i>N</i><sub>A</sub> = 6.02 &times; 10<sup>23</sup> mol<sup>&minus;1</sup>"
     },
     {
      "name": "Molar gas constant",
      "math": "<i>R</i> = 8.31 J K<sup>&minus;1</sup> mol<sup>&minus;1</sup>"
     },
     {
      "name": "Boltzmann constant",
      "math": "<i>k</i> = 1.38 &times; 10<sup>&minus;23</sup> J K<sup>&minus;1</sup>"
     },
     {
      "name": "Stefan constant",
      "math": "&sigma; = 5.67 &times; 10<sup>&minus;8</sup> W m<sup>&minus;2</sup> K<sup>&minus;4</sup>"
     },
     {
      "name": "Permittivity of free space",
      "math": "&epsilon;<sub>0</sub> = 8.85 &times; 10<sup>&minus;12</sup> F m<sup>&minus;1</sup>"
     },
     {
      "name": "Permeability of free space",
      "math": "&mu;<sub>0</sub> = 4&pi; &times; 10<sup>&minus;7</sup> H m<sup>&minus;1</sup>"
     },
     {
      "name": "Electron rest mass",
      "math": "<i>m</i><sub>e</sub> = 9.11 &times; 10<sup>&minus;31</sup> kg"
     },
     {
      "name": "Proton rest mass",
      "math": "<i>m</i><sub>p</sub> = 1.67 &times; 10<sup>&minus;27</sup> kg"
     },
     {
      "name": "g at the Earth’s surface",
      "math": "<i>g</i> = 9.81 N kg<sup>&minus;1</sup>"
     },
     {
      "name": "Atomic mass unit",
      "math": "1 u = 1.661 &times; 10<sup>&minus;27</sup> kg"
     },
     {
      "name": "Wien constant",
      "math": "&alpha; = 2.90 &times; 10<sup>&minus;3</sup> m K"
     }
    ]
   },
   {
    "head": "Particles, waves and quanta",
    "lines": [
     {
      "name": "Photon energy",
      "math": "<i>E</i> = <i>hf</i> = <sup><i>hc</i></sup>&frasl;<sub>&lambda;</sub>"
     },
     {
      "name": "Photoelectric effect",
      "math": "<i>hf</i> = &phi; + <i>E</i><sub>k(max)</sub>"
     },
     {
      "name": "de Broglie wavelength",
      "math": "&lambda; = <sup><i>h</i></sup>&frasl;<sub><i>mv</i></sub>"
     },
     {
      "name": "Wave speed",
      "math": "<i>c</i> = <i>f</i>&lambda;"
     },
     {
      "name": "Refraction",
      "math": "<i>n</i><sub>1</sub> sin &theta;<sub>1</sub> = <i>n</i><sub>2</sub> sin &theta;<sub>2</sub>; &nbsp; <i>n</i> = <sup><i>c</i></sup>&frasl;<sub><i>c</i><sub>s</sub></sub>; &nbsp; sin &theta;<sub>c</sub> = <sup><i>n</i><sub>2</sub></sup>&frasl;<sub><i>n</i><sub>1</sub></sub>"
     },
     {
      "name": "Diffraction grating",
      "math": "<i>d</i> sin &theta; = <i>n</i>&lambda;"
     },
     {
      "name": "Fringe spacing",
      "math": "<i>w</i> = <sup>&lambda;<i>D</i></sup>&frasl;<sub><i>s</i></sub>"
     }
    ]
   },
   {
    "head": "Mechanics and materials",
    "lines": [
     {
      "name": "Constant acceleration",
      "math": "<i>v</i> = <i>u</i> + <i>a</i><i>t</i>; &nbsp; <i>s</i> = <i>u</i><i>t</i> + <sup>1</sup>&frasl;<sub>2</sub> <i>a</i><i>t</i><sup>2</sup>; &nbsp; <i>s</i> = <sup>1</sup>&frasl;<sub>2</sub> (<i>u</i> + <i>v</i>)<i>t</i>; &nbsp; <i>v</i><sup>2</sup> = <i>u</i><sup>2</sup> + 2<i>a</i><i>s</i>"
     },
     {
      "name": "Force and momentum",
      "math": "<i>F</i> = <sup>&Delta;(<i>mv</i>)</sup>&frasl;<sub>&Delta;<i>t</i></sub>"
     },
     {
      "name": "Power",
      "math": "<i>P</i> = <i>Fv</i>",
      "note": "efficiency = useful output power ÷ input power"
     },
     {
      "name": "Density",
      "math": "&rho; = <sup><i>m</i></sup>&frasl;<sub><i>V</i></sub>"
     },
     {
      "name": "Young modulus",
      "math": "<i>E</i> = <sup>tensile stress</sup>&frasl;<sub>tensile strain</sub> = <sup><i>FL</i></sup>&frasl;<sub><i>A</i>&Delta;<i>L</i></sub>"
     },
     {
      "name": "Elastic energy",
      "math": "<i>E</i> = <sup>1</sup>&frasl;<sub>2</sub> <i>F</i>&Delta;<i>L</i>"
     }
    ]
   },
   {
    "head": "Electricity and fields",
    "lines": [
     {
      "name": "Resistivity",
      "math": "&rho; = <sup><i>RA</i></sup>&frasl;<sub><i>L</i></sub>"
     },
     {
      "name": "EMF",
      "math": "&epsilon; = <i>I</i>(<i>R</i> + <i>r</i>)"
     },
     {
      "name": "Capacitance",
      "math": "<i>C</i> = <sup><i>Q</i></sup>&frasl;<sub><i>V</i></sub>; &nbsp; <i>E</i> = <sup>1</sup>&frasl;<sub>2</sub> <i>QV</i>",
      "note": "time constant RC"
     },
     {
      "name": "Capacitor discharge",
      "math": "<i>Q</i> = <i>Q</i><sub>0</sub> e<sup>&minus;<i>t</i>/<i>RC</i></sup>"
     },
     {
      "name": "Gravitation",
      "math": "<i>F</i> = <sup><i>Gm</i><sub>1</sub><i>m</i><sub>2</sub></sup>&frasl;<sub><i>r</i><sup>2</sup></sub>; &nbsp; <i>V</i> = &minus;<sup><i>GM</i></sup>&frasl;<sub><i>r</i></sub>"
     },
     {
      "name": "Electric force",
      "math": "<i>F</i> = <sup><i>Q</i><sub>1</sub><i>Q</i><sub>2</sub></sup>&frasl;<sub>4&pi;&epsilon;<sub>0</sub><i>r</i><sup>2</sup></sub>; &nbsp; <i>E</i> = <sup><i>V</i></sup>&frasl;<sub><i>d</i></sub>",
      "note": "E = V ÷ d in a uniform field"
     },
     {
      "name": "Magnetic force",
      "math": "<i>F</i> = <i>BIl</i>; &nbsp; <i>F</i> = <i>BQv</i>"
     },
     {
      "name": "Induction",
      "math": "&epsilon; = <i>N</i> <sup>&Delta;&Phi;</sup>&frasl;<sub>&Delta;<i>t</i></sub>"
     }
    ]
   },
   {
    "head": "Circles, oscillations, gases and nuclei",
    "lines": [
     {
      "name": "Circular motion",
      "math": "&omega; = <sup><i>v</i></sup>&frasl;<sub><i>r</i></sub>; &nbsp; <i>a</i> = <sup><i>v</i><sup>2</sup></sup>&frasl;<sub><i>r</i></sub> = &omega;<sup>2</sup><i>r</i>"
     },
     {
      "name": "Simple harmonic motion",
      "math": "<i>a</i> = &minus;&omega;<sup>2</sup><i>x</i>; &nbsp; <i>x</i> = <i>A</i> cos &omega;<i>t</i>"
     },
     {
