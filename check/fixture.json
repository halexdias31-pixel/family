  {
   "id": "PP1-Q1",
   "paper": "PP1",
   "q": "1",
   "part": "",
   "kind": "part",
   "section": "",
   "marks": 4,
   "figure": "",
   "lead": "",
   "html": "<p>Write <em>(3 + &radic;5)(2 &minus; &radic;5)</em> in the form <em>a + b&radic;5</em>, where <em>a</em> and <em>b</em> are integers.</p>",
   "answer": "<p>1 &minus; &radic;5, so a = 1 and b = &minus;1. Expanding: 6 &minus; 3&radic;5 + 2&radic;5 &minus; 5.</p>",
   "answerType": "calculation",
   "needsPrint": false,
   "examinerNote": "",
   "examinerReport": "",
   "guide": "",
   "name": "Practice Paper 1 (Non-calculator)",
   "subject": "Maths",
   "tier": "Higher",
   "keystage": "KS4",
   "examBoard": "@family.",
   "resourceType": "Past paper",
   "year": 2026,
   "bandType": "",
