  },
  {
   "id": "PP1-Q6a",
   "paper": "PP1",
   "q": "6",
   "part": "a",
   "kind": "part",
   "section": "",
   "marks": 2,
   "figure": "",
   "lead": "",
   "html": "<p>Find an expression for the <em>n</em>th term.</p>",
   "answer": "<p>6n &minus; 1. The terms go up by 6 each time, and 6 &times; 1 &minus; 1 = 5.</p>",
   "answerType": "calculation",
   "needsPrint": false,
   "examinerNote": "",
   "examinerReport": "",
