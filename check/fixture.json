   "company": ""
  },
  {
   "id": "PP1-Q5",
   "paper": "PP1",
   "q": "5",
   "part": "",
   "kind": "part",
   "section": "",
   "marks": 4,
   "figure": "",
   "lead": "",
   "html": "<p>Solve the simultaneous equations <em>3x + 2y = 19</em> and <em>x &minus; 2y = &minus;3</em>.</p>",
   "answer": "<p>x = 4, y = 3.5. Adding the equations gives 4x = 16, then 4 &minus; 2y = &minus;3.</p>",
   "answerType": "calculation",
   "needsPrint": false,
   "examinerNote": "",
   "examinerReport": "",
   "guide": "",
   "name": "Practice Paper 1 (Non-calculator)",
