# The UI check needs playwright; it is a tool, not part of the site.
node_modules

# Screenshots check/ui.js --shots writes for a human to look at. Regenerated on demand.
check/shots/

.DS_Store
Thumbs.db
*.swp

# Generated deliverables — TSV for pasting into the sheet. Not code, not shipped.
out/

# A payload built by check/live.js is the REAL database — PINs, e-mail addresses, dates of
# birth. This repository is public. check/live.js refuses to write one in here; this is the belt.
check/payload*.json
check/sheets*.json
__pycache__/
